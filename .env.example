# =============================================================================
# SISTEMA DE AUDITORÍA CONTABLE Y CONTROL DE CARTERA - CEA AUTO ORIENTE
# =============================================================================

# Metas Comerciales Mensuales
META_MENSUAL_TOTAL=100
META_MENSUAL_JAVIER_TORRES=30

# Correo Electrónico SMTP (Gmail - Contraseña de Aplicación de 16 letras)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_REMITENTE=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_DESTINATARIOS=gerencia@autooriente.com,contabilidad@autooriente.com

# Bot de Telegram para Alertas y Recepción de Archivos
TELEGRAM_BOT_TOKEN=TU_TELEGRAM_BOT_TOKEN
ADMIN_CHAT_ID=TU_CHAT_ID_DE_TELEGRAM
# Cambia a true si usas un token de bot exclusivo para auditoría (para recibir archivos por chat)
ENABLE_TELEGRAM_BOT_POLLING=false
